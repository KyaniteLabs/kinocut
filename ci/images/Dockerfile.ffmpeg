# ci-images-ffmpeg-{6,7,8} — ci-images-base + one pinned BtbN static FFmpeg on
# PATH. Bakes the exact asset and install/assert steps of the
# test-ffmpeg-matrix legs of ci.yml, so matrix legs start instantly.
#
# Build (one image per major):
#   docker build --platform linux/amd64 -f ci/images/Dockerfile.ffmpeg \
#     --build-arg FFMPEG_MAJOR=6 \
#     --build-arg FFMPEG_TAG=autobuild-2025-08-31-13-00 \
#     --build-arg FFMPEG_ASSET=ffmpeg-n6.1.3-linux64-gpl-6.1.tar.xz \
#     -t ci-images-ffmpeg-6:v1 ci/images/
#   (7: autobuild-2026-06-30-13-34 / ffmpeg-n7.1.5-1-g7d0e842004-linux64-gpl-7.1.tar.xz
#    8: autobuild-2026-06-30-13-34 / ffmpeg-n8.1.2-21-gce3c09c101-linux64-gpl-8.1.tar.xz)
ARG BASE_IMAGE=ci-images-base:v1
FROM ${BASE_IMAGE}

ARG FFMPEG_MAJOR
ARG FFMPEG_TAG
ARG FFMPEG_ASSET

# /bin/sh (dash) has no pipefail; plain set -eu keeps the classic builder happy.
RUN set -eu; \
    url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_TAG}/${FFMPEG_ASSET}"; \
    echo "Downloading $url"; \
    curl -fsSL --retry 3 --retry-delay 5 "$url" -o /tmp/ffmpeg.tar.xz; \
    mkdir -p /tmp/ffmpeg-static; \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg-static; \
    bindir="$(dirname "$(find /tmp/ffmpeg-static -type f -name ffmpeg | head -1)")"; \
    echo "Resolved static FFmpeg bin dir: $bindir"; \
    cp "$bindir/ffmpeg" "$bindir/ffprobe" /usr/local/bin/; \
    rm -rf /tmp/ffmpeg-static /tmp/ffmpeg.tar.xz; \
    ver="$(ffmpeg -version | head -1)"; \
    echo "$ver"; \
    ffprobe -version | head -1; \
    case "$ver" in \
      *"version n${FFMPEG_MAJOR}."*|*"version ${FFMPEG_MAJOR}."*) \
        echo "FFmpeg major ${FFMPEG_MAJOR} confirmed." ;; \
      *) \
        echo "ERROR: expected FFmpeg major ${FFMPEG_MAJOR}, got: $ver" >&2; \
        exit 1 ;; \
    esac
